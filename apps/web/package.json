{
  "name": "@worknaru/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs && vitest run",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "ui:verify": "pnpm storybook:build && playwright test",
    "ui:lint": "eslint src ../../packages/ui/src && stylelint \"src/**/*.css\" \"../../packages/ui/src/**/*.css\""
  },
  "dependencies": {
    "@worknaru/branding": "workspace:*",
    "@worknaru/core": "workspace:*",
    "@worknaru/paseo-adapter": "workspace:*",
    "@worknaru/ui": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "storybook": "10.6.0",
    "stylelint": "17.15.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
